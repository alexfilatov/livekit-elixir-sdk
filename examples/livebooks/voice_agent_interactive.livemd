# LiveKit Voice Agent - Interactive Demo

## Section

```elixir
# Setup Instructions:
# 1. First, compile the LiveKit project by running this in the terminal:
#    cd /path/to/livekit && mix deps.get && mix compile
# 2. Then run this Livebook from the livekit directory

# Check if we're running from the correct directory and find LiveKit project
current_dir = File.cwd!()

# Try to find the LiveKit project in several possible locations
possible_livekit_paths = [
  current_dir,                                                    # Current directory
  Path.expand("../..", current_dir),                             # Two levels up (if in examples/livebooks)
  "/Users/alex/livekit",                                         # Specific path based on your setup
  "/Users/alex/Projects/my/livekit/livekit",                    # Alternative path
  Path.join(System.user_home!(), "livekit"),                    # Home directory
  Path.join(System.user_home!(), "Projects/my/livekit/livekit") # Projects directory
]

livekit_root = Enum.find(possible_livekit_paths, fn path ->
  File.exists?(Path.join(path, "mix.exs")) and
  File.exists?(Path.join(path, "lib/livekit.ex"))
end)

IO.puts("Current directory: #{current_dir}")
IO.puts("Searching for LiveKit project...")

if livekit_root do
  IO.puts("✅ Found LiveKit project at: #{livekit_root}")
else
  IO.puts("❌ Could not find LiveKit project in any of these locations:")
  Enum.each(possible_livekit_paths, fn path -> IO.puts("  - #{path}") end)
  IO.puts("\nPlease ensure the LiveKit project exists and try one of these:")
  IO.puts("1. Start Livebook from the LiveKit directory: cd /Users/alex/livekit && livebook server")
  IO.puts("2. Or copy this notebook to your LiveKit project directory")
end

# Install dependencies for Livebook
Mix.install([
  {:kino, "~> 0.12.0"},
  {:req, "~> 0.4.0"}
])

# If we found the project, set it up
if livekit_root do
  # Check if compiled
  ebin_path = Path.join([livekit_root, "_build", "dev", "lib", "livekit", "ebin"])
  if File.exists?(ebin_path) do
    IO.puts("✅ LiveKit appears to be compiled")
    Code.prepend_path(ebin_path)

    # Also add dependencies to the path
    deps_path = Path.join([livekit_root, "_build", "dev", "lib"])
    if File.exists?(deps_path) do
      deps_dirs = File.ls!(deps_path)
      Enum.each(deps_dirs, fn dep ->
        dep_ebin = Path.join([deps_path, dep, "ebin"])
        if File.exists?(dep_ebin) do
          Code.prepend_path(dep_ebin)
        end
      end)
      IO.puts("✅ Added dependency paths")
    end
  else
    IO.puts("⚠️ LiveKit not compiled. Please run 'mix compile' in the LiveKit directory first.")
    IO.puts("Run this command: cd #{livekit_root} && mix deps.get && mix compile")
  end
end
```

