]

IO.puts("🔍 Checking LiveKit modules...")

all_loaded = Enum.all?(modules_to_check, fn module ->
  if Code.ensure_loaded?(module) do
    IO.puts("✅ #{module}")
    true
  else
    IO.puts("❌ #{module} - NOT LOADED")
    false
  end
end)

if all_loaded do
  IO.puts("\n🎉 All LiveKit modules loaded successfully!")
  IO.puts("LiveKit version: #{Livekit.version()}")
else
  IO.puts("\n❌ Some modules failed to load.")
  IO.puts("Please ensure you've compiled the LiveKit project:")
  IO.puts("1. cd #{livekit_root}")
