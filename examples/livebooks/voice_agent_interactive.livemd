  {"gpt-4o-mini", "GPT-4o Mini"},
  {"gpt-4o", "GPT-4o"},
  {"gpt-3.5-turbo", "GPT-3.5 Turbo"}
], default: "gpt-4o-mini")
openai_voice_input = Kino.Input.select("OpenAI Voice", [
  {"alloy", "Alloy"},
  {"echo", "Echo"},
  {"fable", "Fable"},
  {"onyx", "Onyx"},
  {"nova", "Nova"},
  {"shimmer", "Shimmer"}
], default: "alloy")
deepgram_model_input = Kino.Input.select("Deepgram Model", [
  {"nova-2", "Nova 2"},
  {"nova", "Nova"},
  {"enhanced", "Enhanced"},
  {"base", "Base"}
], default: "nova-2")

Kino.Layout.grid([
  room_name_input,
  agent_name_input,
  agent_instructions_input,
